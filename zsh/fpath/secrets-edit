# Edit a secret in the private secrets repo, then re-render this box.
#
# Ciphertext is canonical; every rendered plaintext is derived from it. So the
# only correct way to change a secret is to edit it here and re-render — never
# by editing a rendered target, which the next deploy silently overwrites.
#
# Usage: secrets-edit shell/95_tailscale_secrets.yaml
#        secrets-edit                    # list what is editable
#
# Replaces dotfiles-encrypt, which encrypted plaintext into tracked .enc files
# back when the dotfiles repo was dual-canonical.

local secrets_dir=${SECRETS_DIR:-$HOME/.local/secrets}
local dotfiles_dir=${DOTFILES:-$HOME/.local/dotfiles}

if ! command -v sops >/dev/null 2>&1; then
    print "Error: sops not found. Run 'mise install' first." >&2
    return 1
fi
if [[ ! -d $secrets_dir/.git ]]; then
    print "Error: no secrets clone at $secrets_dir." >&2
    print "Run ./deploy.zsh — scripts/deploy.d/65_secrets.zsh clones it, and" >&2
    print "prints the bootstrap instructions if this box lacks credentials." >&2
    return 1
fi

if (( $# != 1 )); then
    print "Usage: secrets-edit <path-in-secrets-repo>" >&2
    print "" >&2
    print "Editable files:" >&2
    git -C $secrets_dir ls-files 'shell/*' 'services/*' >&2
    return 1
fi

if [[ ! -f $secrets_dir/$1 ]]; then
    print "Error: $1 not found in $secrets_dir" >&2
    return 1
fi

# cd so sops picks up the secrets repo's .sops.yaml (recipient list); a
# subshell keeps the caller's cwd untouched.
( cd $secrets_dir && sops edit $1 ) || return 1

# Re-render immediately: the edit is not live on this box until it is.
zsh $dotfiles_dir/scripts/secrets-render.zsh || return 1

print ""
print "Rendered locally. Publish so the rest of the fleet picks it up on next pull:"
print "  git -C $secrets_dir commit -am 'chore: update $1'"
print "  git -C $secrets_dir push"
