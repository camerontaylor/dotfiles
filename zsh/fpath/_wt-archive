#compdef wt-archive

_wt-archive() {
    local -a worktrees

    local git_root
    git_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1

    while IFS=$'\t' read -r path branch; do
        [[ -n "$path" ]] || continue
        [[ "$path" == "$git_root" ]] && continue

        if [[ -n "$branch" ]]; then
            worktrees+=("${branch#refs/heads/}:${path}")
        else
            worktrees+=("$path")
        fi
    done < <(
        git -C "$git_root" worktree list --porcelain |
            awk '
                /^worktree / { path=substr($0,10); branch="" }
                /^branch refs\/heads\// { branch=substr($0,19) }
                /^$/ {
                    if (path != "") { print path "\t" branch }
                    path=""; branch=""
                }
                END {
                    if (path != "") { print path "\t" branch }
                }
            '
    )

    if (( ${#worktrees[@]} )); then
        _describe 'worktrees' worktrees
    else
        _files
    fi
}

_wt-archive "$@"

