emulate -L zsh

local root meta source target newpwd
root="$(_webfront_root)" || {
    print -u2 -- "wt-archive is only available inside a compatible webfront repository"
    return 1
}

case " $* " in
    *" -h "*|*" --help "*)
        command bash "$root/scripts/wt-archive" "$@"
        return
        ;;
esac

meta="$(command bash "$root/scripts/wt-archive" --resolve-paths "$@")" || return
source="${meta%%|*}"
target="${meta#*|}"

if [[ -n "$source" && "$PWD" == "$source" ]]; then
    newpwd="$target"
elif [[ -n "$source" && "$PWD" == "$source"/* ]]; then
    newpwd="$target/${PWD#$source/}"
fi

command bash "$root/scripts/wt-archive" "$@"
(( $? == 0 )) || return

[[ -n "$newpwd" ]] && builtin cd -- "$newpwd"

# vim: ft=zsh
