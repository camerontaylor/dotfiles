{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "repomapper": {
      "type": "local",
      "command": [
        "/home/ctaylor/.local/bin/repomap-mcp"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "web-to-mcp": {
      "type": "remote",
      "url": "https://web-to-mcp.com/mcp/541f0cbf-c5e3-4e77-9170-885d742bb4bf/",
      "enabled": true,
      "timeout": 120000
    },
    "react-grab-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@react-grab/mcp",
        "--stdio"
      ]
    }
  },
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-antigravity-auth@1.6.0",
    "opencode-beads"
  ],
  "tools": {
    "webfetch": false,
    "exa_*": false,
    "context7_*": false,
    "google_*": false,
    "websearch_*": false
  },
  "permission": {
    "webfetch": "deny",
    "exa_*": "deny",
    "context7_*": "deny",
    "google_*": "deny",
    "websearch_*": "deny"
  }
}
