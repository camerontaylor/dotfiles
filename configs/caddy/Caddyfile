# Auto-generated for ceres (mirror of pluto setup)
# TLS termination for *.ceres.webfront.app via Cloudflare DNS-01 challenge
# Proxies to portless on localhost:8080, rewriting Host to match portless TLD
# t3.ceres.webfront.app is carved out to reach the T3 Code server on localhost:3773

t3.ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# T3 Code web GUI — WebSocket server bound to localhost:3773 (`t3 serve`).
	# This specific site address wins over the *.ceres.webfront.app wildcard
	# below, so T3 traffic reaches 3773 instead of portless on 8080.
	# reverse_proxy upgrades WebSocket automatically; TLS here satisfies the
	# browser mixed-content rule for an HTTPS page talking to a backend.
	reverse_proxy localhost:3773
}

*.ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Rewrite Host: foo.ceres.webfront.app → foo.ceres (portless TLD = hostname)
	reverse_proxy localhost:8080 {
		header_up Host {http.request.host.labels.3}.ceres
	}
}

ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	respond "ceres dev server" 200
}

# Langfuse web — telemetry.webfront.app → langfuse-web container on localhost:3000
# CNAME on Cloudflare: telemetry.webfront.app → ceres.webfront.app
# DNS-01 cert via Cloudflare token (same as other blocks above)
telemetry.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	reverse_proxy localhost:3000
}

# OpenClaw MCP bridge — claude.ai custom connector endpoint (added 2026-07-14)
# Specific site address wins over the *.ceres.webfront.app wildcard above,
# so this reaches the bridge on 3111 instead of portless on 8080.
# Connector URL used in claude.ai MUST be https://mcp.ceres.webfront.app/mcp
mcp.ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# hart wiki MCP (port 3112) — /wiki/* plus its RFC 8414/9728 metadata
	# paths. Everything else stays with the openclaw-mcp bridge on 3111,
	# including the bridge's own /.well-known/* at the root.
	@wiki path /wiki /wiki/* /.well-known/oauth-authorization-server/wiki* /.well-known/oauth-protected-resource/wiki*
	handle @wiki {
		reverse_proxy localhost:3112
	}
	handle {
		reverse_proxy localhost:3111
	}
}

# Immich — tailnet-only (added 2026-08-26, photo-steward).
# Unlike mcp/fred/miniflux.wedrifid.dev (orange-cloud CNAMEs into the
# Cloudflare Tunnel), this is a grey-cloud A record straight at ceres's
# Tailscale IP: Cloudflare answers DNS only and never proxies traffic.
# Separate token because wedrifid.dev is the personal Cloudflare account
# while webfront.app (CF_API_TOKEN above) is a different account entirely.
# DNS-01 is mandatory: Let's Encrypt cannot reach 100.82.17.115 (CGNAT).
immich.wedrifid.dev {
	tls {
		dns cloudflare {env.CF_WEDRIFID_TOKEN}
	}

	# Caddy listens on *:443 and ceres has a public IP, so do not rely on
	# the DNS record alone — refuse anything not arriving over the tailnet.
	@external not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @external

	# Backend moved to makemake 2026-09-08 (M5). Wired office LAN first
	# (10.77.0.97 — same switch, line rate), makemake's tailnet IP as
	# fallback if the cable is out. lb_policy first sends all traffic to
	# the wired upstream; fail_duration marks it down for 30s on failure.
	reverse_proxy 10.77.0.97:2283 100.87.185.24:2283 {
		lb_policy first
		fail_duration 30s
	}
}

# CodexBar LLM plan-quota collector — tailnet-only (added 2026-09-04).
# Same shape as immich.wedrifid.dev above: grey-cloud A record at ceres's
# Tailscale IP, DNS-01 cert (Let's Encrypt cannot reach 100.82.17.115),
# personal-account token because wedrifid.dev != webfront.app.
# Backend is codexbar-serve.service, bound to 127.0.0.1:8791 only.
usage.wedrifid.dev {
	tls {
		dns cloudflare {env.CF_WEDRIFID_TOKEN}
	}

	# Caddy listens on *:443 and ceres has a public IP, so do not rely on
	# the DNS record alone — refuse anything not arriving over the tailnet.
	@external not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @external

	# CodexBar rejects any request whose Host is not its own bind address
	# ({"error":"forbidden host"}) — a DNS-rebinding guard with no allowlist
	# flag or env var. Rewrite Host to the dial target so it sees a loopback
	# request. The remote_ip matcher above is unaffected: it reads the peer
	# address, not this header, so the tailnet boundary still holds.
	reverse_proxy 127.0.0.1:8791 {
		header_up Host {upstream_hostport}
		# Token-free dashboard for tailnet clients: CodexBar gates only
		# /dashboard/v1/snapshot, and its web UI prompts for the token only
		# when that endpoint answers 401 (it sends nothing when the browser
		# has none stored). Injecting the bearer here means browsers never
		# see or store it. The @external abort above is the boundary, and
		# the snapshot is identity-redacted — strictly less than /usage
		# already exposes on this vhost. Value synced from
		# ~/.local/state/codexbar/dashboard-token into /etc/caddy/env by
		# setup-caddy-usage-site.sh; if absent this becomes "Bearer " and
		# the old token-prompt behaviour returns, so it fails safe.
		header_up Authorization "Bearer {env.CODEXBAR_DASHBOARD_TOKEN}"
	}
}

# ntfy — quota cue delivery, tailnet-only (added 2026-09-06).
# Grey-cloud A record at ceres's Tailscale IP, same as immich/usage above.
# Host is deliberately NOT rewritten: ntfy builds links from base-url and the
# request host, and its Android client subscribes over long-lived SSE.
ntfy.wedrifid.dev {
	tls {
		dns cloudflare {env.CF_WEDRIFID_TOKEN}
	}

	# Caddy listens on *:443 and ceres has a public IP, so do not rely on
	# the DNS record alone — refuse anything not arriving over the tailnet.
	@external not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @external

	reverse_proxy 127.0.0.1:2586 {
		# ntfy subscriptions are long-lived SSE/WebSocket streams; disable
		# response buffering so cues arrive immediately rather than in chunks.
		flush_interval -1
	}
}

# Appreciation — the private record of time with Ollie. Tailnet-only (added 2026-09-05).
# Same shape as immich/usage/ntfy above: grey-cloud A record at ceres's Tailscale IP, DNS-01
# cert (Let's Encrypt cannot reach 100.82.17.115), personal-account token.
#
# Backend is a unix socket, NOT a loopback port, and that is load-bearing. The app derives who
# you are from X-Forwarded-For and only trusts that header when it arrives over the socket —
# on a TCP port any process on ceres could set it and be admitted as Cameron. /run/appreciation
# is 0750 ctaylor:caddy (tmpfiles.d) and the socket 0660, so the kernel decides who may connect.
# The app refuses to start if either is wider. See appreciation/docs/adr/0005 and server.ts.
appreciation.wedrifid.dev {
	tls {
		dns cloudflare {env.CF_WEDRIFID_TOKEN}
	}

	# Caddy listens on *:443 and ceres has a public IP, so do not rely on the DNS record alone —
	# refuse anything not arriving over the tailnet. This is the outer of two gates: Caddy drops
	# non-tailnet peers here, and the app then resolves the tailnet address to an identity and
	# admits only Cameron's own devices, not tagged nodes.
	@external not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @external

	# Phone photos. adapter-node's own BODY_SIZE_LIMIT is raised to match in the unit file.
	request_body {
		max_size 64MB
	}

	reverse_proxy unix//run/appreciation/app.sock
}
