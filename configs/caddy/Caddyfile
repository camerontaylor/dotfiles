# Auto-generated for ceres (mirror of pluto setup)
# TLS termination for *.ceres.webfront.app via Cloudflare DNS-01 challenge
# Proxies to portless on localhost:8080, rewriting Host to match portless TLD
# t3.ceres.webfront.app is carved out to reach the T3 Code server on localhost:3773

t3.ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# T3 Code web GUI — WebSocket server bound to localhost:3773 (`t3 serve`).
	# This specific site address wins over the *.ceres.webfront.app wildcard
	# below, so T3 traffic reaches 3773 instead of portless on 8080.
	# reverse_proxy upgrades WebSocket automatically; TLS here satisfies the
	# browser mixed-content rule for an HTTPS page talking to a backend.
	reverse_proxy localhost:3773
}

*.ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Rewrite Host: foo.ceres.webfront.app → foo.ceres (portless TLD = hostname)
	reverse_proxy localhost:8080 {
		header_up Host {http.request.host.labels.3}.ceres
	}
}

ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	respond "ceres dev server" 200
}

# Langfuse web — telemetry.webfront.app → langfuse-web container on localhost:3000
# CNAME on Cloudflare: telemetry.webfront.app → ceres.webfront.app
# DNS-01 cert via Cloudflare token (same as other blocks above)
telemetry.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	reverse_proxy localhost:3000
}

# OpenClaw MCP bridge — claude.ai custom connector endpoint (added 2026-07-14)
# Specific site address wins over the *.ceres.webfront.app wildcard above,
# so this reaches the bridge on 3111 instead of portless on 8080.
# Connector URL used in claude.ai MUST be https://mcp.ceres.webfront.app/mcp
mcp.ceres.webfront.app {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# hart wiki MCP (port 3112) — /wiki/* plus its RFC 8414/9728 metadata
	# paths. Everything else stays with the openclaw-mcp bridge on 3111,
	# including the bridge's own /.well-known/* at the root.
	@wiki path /wiki /wiki/* /.well-known/oauth-authorization-server/wiki* /.well-known/oauth-protected-resource/wiki*
	handle @wiki {
		reverse_proxy localhost:3112
	}
	handle {
		reverse_proxy localhost:3111
	}
}

# ── snippet: the wedrifid.dev tailnet gate ──────────────────────────────────
# Every wedrifid.dev vhost below imports this, and it is the whole of the
# security boundary. Spelled once rather than per-block because there are now
# twenty-odd of them and a block that silently omitted it would be genuinely
# internet-facing, not merely misconfigured:
#
#   - Caddy binds *:443 and ceres has a PUBLIC IP. The grey-cloud A record
#     pointing at 100.82.17.115 is addressing, not access control — anyone who
#     resolves the name and connects reaches this process.
#   - So the remote_ip matcher is what actually keeps these private. It reads
#     the peer address, which no header can forge.
#
# infra `bin/render-fleet-page --check-caddy` fails if any wedrifid.dev vhost
# lacks `abort @external` and is not declared exposure="public" in the catalog.
#
# DNS-01 is mandatory: Let's Encrypt cannot reach a CGNAT address to do HTTP-01.
# CF_WEDRIFID_TOKEN is the personal Cloudflare account — a different account
# from webfront.app's CF_API_TOKEN above, and the two are not interchangeable.
(wedrifid_tailnet) {
	tls {
		dns cloudflare {env.CF_WEDRIFID_TOKEN}
	}
	@external not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @external
}

# Immich — tailnet-only (added 2026-08-26, photo-steward).
# Unlike mcp/fred/miniflux.wedrifid.dev (orange-cloud CNAMEs into the
# Cloudflare Tunnel), this is a grey-cloud A record straight at ceres's
# Tailscale IP: Cloudflare answers DNS only and never proxies traffic.
# Separate token because wedrifid.dev is the personal Cloudflare account
# while webfront.app (CF_API_TOKEN above) is a different account entirely.
# DNS-01 is mandatory: Let's Encrypt cannot reach 100.82.17.115 (CGNAT).
immich.wedrifid.dev {
	import wedrifid_tailnet

	# Backend moved to makemake 2026-09-08 (M5). Wired office LAN first
	# (10.77.0.2 — same switch, line rate), makemake's tailnet IP as
	# fallback if the cable is out. lb_policy first sends all traffic to
	# the wired upstream; fail_duration marks it down for 30s on failure.
	reverse_proxy 10.77.0.2:2283 100.87.185.24:2283 {
		lb_policy first
		fail_duration 30s
	}
}

# CodexBar LLM plan-quota collector — tailnet-only (added 2026-09-04;
# upstream moved to neptune 2026-09-10). Same shape as immich.wedrifid.dev
# above: grey-cloud A record at ceres's Tailscale IP, DNS-01 cert (Let's
# Encrypt cannot reach 100.82.17.115), personal-account token because
# wedrifid.dev != webfront.app.
# Backend is the com.github.ctaylor.codexbar-serve LaunchAgent on neptune
# (100.84.239.15, direct LAN peer of ceres), bound to its Tailscale address.
# The collector lives on a Mac because CodexBar's cookie-based sources are
# macOS-only — see ~/.local/agents/docs/llm-quota.md.
usage.wedrifid.dev {
	import wedrifid_tailnet

	# CodexBar rejects any request whose Host is not its own bind address
	# ({"error":"forbidden host"}) — a DNS-rebinding guard with no allowlist
	# flag or env var. Rewrite Host to the dial target so it sees a request
	# for its own bind address. The remote_ip matcher above is unaffected:
	# it reads the peer address, not this header, so the tailnet boundary
	# still holds.
	reverse_proxy 100.84.239.15:8791 {
		header_up Host {upstream_hostport}
		# Token-free dashboard for tailnet clients: CodexBar's web UI
		# prompts for a token only when an endpoint answers 401 (it sends
		# nothing when the browser has none stored). Injecting the bearer
		# here means browsers never see or store it. On the non-loopback
		# bind this token ALSO gates /usage and /cost upstream — CodexBar
		# only leaves those open on loopback — so this header is now what
		# authenticates every proxied path, not just the snapshot. The
		# @external abort above remains the network boundary; the snapshot
		# is identity-redacted. Value synced from
		# ~/.local/state/codexbar/dashboard-token into /etc/caddy/env by
		# setup-caddy-usage-site.sh — that file is now a MIRROR pushed from
		# neptune, where the collector generates it (dotfiles
		# 78_codexbar_serve.zsh prints the push command); if absent this
		# becomes "Bearer " and endpoints answer 401, so it fails closed.
		header_up Authorization "Bearer {env.CODEXBAR_DASHBOARD_TOKEN}"
	}
}

# ntfy — quota cue delivery, tailnet-only (added 2026-09-06).
# Grey-cloud A record at ceres's Tailscale IP, same as immich/usage above.
# Host is deliberately NOT rewritten: ntfy builds links from base-url and the
# request host, and its Android client subscribes over long-lived SSE.
ntfy.wedrifid.dev {
	import wedrifid_tailnet

	reverse_proxy 127.0.0.1:2586 {
		# ntfy subscriptions are long-lived SSE/WebSocket streams; disable
		# response buffering so cues arrive immediately rather than in chunks.
		flush_interval -1
	}
}

# Appreciation — the private record of time with Ollie. Tailnet-only (added 2026-09-05).
# Same shape as immich/usage/ntfy above: grey-cloud A record at ceres's Tailscale IP, DNS-01
# cert (Let's Encrypt cannot reach 100.82.17.115), personal-account token.
#
# Backend is a unix socket, NOT a loopback port, and that is load-bearing. The app derives who
# you are from X-Forwarded-For and only trusts that header when it arrives over the socket —
# on a TCP port any process on ceres could set it and be admitted as Cameron. /run/appreciation
# is 0750 ctaylor:caddy (tmpfiles.d) and the socket 0660, so the kernel decides who may connect.
# The app refuses to start if either is wider. See appreciation/docs/adr/0005 and server.ts.
appreciation.wedrifid.dev {
	import wedrifid_tailnet

	# The import above is only the OUTER of two gates. Caddy drops non-tailnet
	# peers here; the app then resolves the tailnet address to an identity and
	# admits only Cameron's own devices, not tagged nodes. Nothing else behind
	# this ingress does that second step.

	# Phone photos. adapter-node's own BODY_SIZE_LIMIT is raised to match in the unit file.
	request_body {
		max_size 64MB
	}

	reverse_proxy unix//run/appreciation/app.sock
}

# Plex Media Server — tailnet-only (added 2026-09-11). Backend on makemake.
# Same shape as immich.wedrifid.dev above: grey-cloud A record straight at
# ceres's Tailscale IP, personal-account token because wedrifid.dev is a
# different Cloudflare account from webfront.app. DNS-01 is mandatory —
# Let's Encrypt cannot reach 100.82.17.115 (CGNAT).
#
# NOTE: this vhost is for browsers. The Plex *apps* do not use it; they pick
# a direct route from the server's advertised URLs (ADVERTISE_IP in
# ~/repos/deploy/plex/.env on makemake) or fall back to the plex.tv relay.
# Removing this block therefore does not cut off the Plex clients.
plex.wedrifid.dev {
	import wedrifid_tailnet

	# Wired office LAN first (10.77.0.2 — same switch, line rate),
	# makemake's tailnet IP as fallback if the cable is out. Identical
	# upstream pair and policy to immich above.
	# Bare / is an authenticated PMS API endpoint (401), not the web app, so a
	# browser hitting the vhost root falls through to Plex's hosted page
	# instead of this server. Send browsers to the locally-bundled web client.
	# Redirect to /web, NOT straight to /web/index.html: Plex's own /web
	# handler 302s to /web/index.html#!/setup/<machineIdentifier>, and that
	# fragment is what pins the app to THIS server. Without it the web app
	# loads with no server selected and shows Plex's own catalog instead.
	redir / /web 302
	reverse_proxy 10.77.0.2:32400 100.87.185.24:32400 {
		lb_policy first
		fail_duration 30s
		# Plex builds redirect URLs from the scheme it sees. Caddy
		# terminates TLS and proxies plain HTTP upstream, so /web 302s to
		# an http:// Location, downgrading the browser. Rewrite it back.
		header_down Location "^http://plex.wedrifid.dev" "https://plex.wedrifid.dev"
		# Plex pushes library/playback activity over a long-lived
		# EventSource stream (/:/eventsource/notifications) and a
		# WebSocket. Disable response buffering so those arrive
		# immediately rather than in chunks — same reason as ntfy above.
		flush_interval -1
	}
}

# Audiobookshelf — audiobook server on makemake, tailnet-only (added 2026-09-17).
# Same shape as immich/plex.wedrifid.dev above: grey-cloud A record straight at
# ceres's Tailscale IP, personal-account token because wedrifid.dev is a
# different Cloudflare account from webfront.app. DNS-01 is mandatory —
# Let's Encrypt cannot reach 100.82.17.115 (CGNAT).
#
# SINGLE upstream, wired LAN only (changed same day, owner direction): the
# makemake compose moved off its tailnet bind to 10.77.0.2 — the domain is
# THE access path and direct tailnet access is retired. No tailnet fallback
# exists BY THAT CHOICE: if the office cable drops, ABS is unreachable even
# via this vhost (immich/plex keep a fallback; ABS deliberately does not).
abs.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 10.77.0.2:13378 {
		# ABS keeps the web UI live over a long-lived WebSocket (library
		# scans, playback progress) and serves audiobook files as long
		# streaming responses; disable response buffering so both arrive
		# as generated — same reason as ntfy/plex above.
		flush_interval -1
	}
}

# ═══════════════════════════════════════════════════════════════════════════
# The fleet's remaining web UIs (added 2026-09-17).
#
# Everything below imports `wedrifid_tailnet` above — grey-cloud A record at
# 100.82.17.115, DNS-01 cert, and the remote_ip abort that is the actual
# boundary. Catalogued in infra web/catalog.toml, which renders the landing
# page and cross-checks this file (`bin/render-fleet-page --check-caddy`).
#
# All the makemake upstreams here are the host's TAILNET bind, not its wired
# LAN IP — unlike immich/plex/abs, which bind both. That is a real difference
# in failure mode, not an oversight: a tailnet bind comes up only after the
# boot-race drop-in's wait-for-tailscale-ip completes, so these services are
# late-starting on a cold boot where the wired ones are not. Moving one to a
# dual bind is a compose edit plus a container recreate, deliberately not
# bundled into an ingress change.
# ═══════════════════════════════════════════════════════════════════════════

# ── the landing page itself ────────────────────────────────────────────────
# Static files, served straight off disk by this same Caddy — no application,
# no container, no database. It therefore has no failure mode of its own: if
# this page is down, the thing that serves every other name here is also down.
#
# /var/www/fleet rather than anywhere under /home/ctaylor, which is 0700 and
# unreadable to User=caddy — the same constraint that makes /etc/caddy/Caddyfile
# a copy rather than a symlink. Installed by infra bin/install-fleet-page.
fleet.wedrifid.dev {
	import wedrifid_tailnet

	root * /var/www/fleet
	encode zstd gzip
	file_server

	# The icons change only when the catalog does; the page itself must not be
	# cached or an edit appears not to have landed.
	#
	# BOTH paths, and that is not belt-and-braces: file_server serves the page
	# at `/` without rewriting the request path, so a matcher for /index.html
	# alone never fires for the URL everybody actually visits.
	header /icons/* Cache-Control "public, max-age=604800"
	# Go's mime table has no entry for .webmanifest, so file_server serves it
	# with no Content-Type at all and the browser declines to install the PWA.
	header /manifest.webmanifest Content-Type "application/manifest+json"
	header / Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
}

