# ── downloaders ────────────────────────────────────────────────────────────

# qBittorrent needs THREE header changes, and two of them are easy to miss:
#
#   1. Host -> the dial target. The WebUI validates the Host header against
#      its own bind address and answers "Unauthorized" otherwise. Same
#      dial-target rewrite as the usage vhost, same reason.
#   2/3. Origin and Referer STRIPPED. Rewriting Host alone is not enough:
#      qBittorrent's CSRF check compares Origin/Referer against Host, so
#      after step 1 the browser's `https://qbit.wedrifid.dev` Origin no
#      longer matches the rewritten Host and every state-changing request
#      fails 403 — logging in works, then nothing else does.
#
# The alternative is turning off HostHeaderValidation + CSRFProtection in
# qBittorrent itself, which weakens the app for every client and needs a
# container recreate. Fixing it at the ingress keeps the blast radius here.
qbit.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 100.87.185.24:8080 {
		header_up Host {upstream_hostport}
		header_up -Origin
		header_up -Referer
	}
}

# slskd's UI is driven by SignalR and shows live transfer progress; where that
# falls back to long-polling rather than a WebSocket, buffering would make
# progress arrive in lumps.
slskd.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 100.87.185.24:5030 {
		flush_interval -1
	}
}

soularr.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 100.87.185.24:8265 {
		flush_interval -1
	}
}

pyload.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 100.87.185.24:8000
}

# YTPTube streams download progress to the page as it happens.
ytptube.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 100.87.185.24:8081 {
		flush_interval -1
	}
}

# ── fleet ──────────────────────────────────────────────────────────────────

# Syncthing is the qBittorrent case again: its GUI runs its own host check and
# rejects a proxied request whose Host it does not recognise. Rewriting Host to
# the dial target satisfies it without setting insecureSkipHostcheck, which
# would drop the protection for every client rather than just this path.
# flush_interval because the GUI tracks state through a long-poll /rest/events
# stream — buffered, the UI simply stops updating.
syncthing.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 100.87.185.24:8384 {
		header_up Host {upstream_hostport}
		flush_interval -1
	}
}

# SeaweedFS filer browser — the object store behind Langfuse. Note this filer
# ALREADY binds 0.0.0.0:8888, so it is reachable from the whole LAN with or
# without this vhost; the hostname adds convenience, not exposure. It can
# delete objects: an admin surface, not a file manager.
seaweed.wedrifid.dev {
	import wedrifid_tailnet
	reverse_proxy 127.0.0.1:8888
}
