# Template for /etc/caddy/env  (mode 600, owner caddy:caddy).
#
# NEVER commit the real file. The live one is root/caddy-readable only.
#
# Consumed by: /etc/systemd/system/caddy.service -> EnvironmentFile=/etc/caddy/env
# Referenced by: every `tls { dns cloudflare {env.*} }` block in
# configs/caddy/Caddyfile, plus the usage.wedrifid.dev reverse_proxy's
# `header_up Authorization "Bearer {env.CODEXBAR_DASHBOARD_TOKEN}"`.
#
# EnvironmentFile= is read at unit START — after editing this file, apply with
# `systemctl restart caddy` (reload may not re-resolve {env.*}). This is why
# scripts/setup-caddy-usage-site.sh restarts rather than reloads when it
# changes the dashboard token.
#
# Canonical sources of the real values:
#   CF_API_TOKEN          shell/91_cloudflare_secrets.yaml in the private
#                         secrets repo (~/.local/secrets), rendered to
#                         $XDG_STATE_HOME/secrets/zsh/91_cloudflare_secrets.zsh
#                         on every deploy (any new shell already exports it).
#   CF_WEDRIFID_TOKEN     no canonical copy yet (see docs/caddy-ingress.md).
#   CODEXBAR_DASHBOARD_TOKEN  regenerated by scripts/setup-llm-quota.sh into
#                         ~/.local/state/codexbar/dashboard-token; synced here
#                         by scripts/setup-caddy-usage-site.sh (idempotent —
#                         prefer re-running that over editing by hand).
#
# With CF_API_TOKEN in the environment:
#   printf 'CF_API_TOKEN=%s\n' "$CF_API_TOKEN" | sudo tee /etc/caddy/env >/dev/null
#   sudo chmod 600 /etc/caddy/env && sudo chown caddy:caddy /etc/caddy/env
#
# Cloudflare token scopes required: CF_API_TOKEN Zone:DNS:Edit on webfront.app;
# CF_WEDRIFID_TOKEN Zone:DNS:Edit on wedrifid.dev.

CF_API_TOKEN=cloudflare-api-token-goes-here
CF_WEDRIFID_TOKEN=cloudflare-wedrifid-token-goes-here
CODEXBAR_DASHBOARD_TOKEN=codexbar-dashboard-token-goes-here
