# Template for /etc/caddy/env  (mode 600, owner caddy:caddy).
#
# NEVER commit the real file. The live one is 54 bytes, root/caddy-readable
# only, and holds exactly the one variable below.
#
# Consumed by: /etc/systemd/system/caddy.service -> EnvironmentFile=/etc/caddy/env
# Referenced by: every `tls { dns cloudflare {env.CF_API_TOKEN} }` block in
# configs/caddy/Caddyfile (5 of them) for the DNS-01 challenge.
#
# Canonical source of the real value: zsh/env.d/91_cloudflare_secrets.zsh,
# tracked in this repo only as the sops-encrypted 91_cloudflare_secrets.zsh.enc.
# Restore with `scripts/restore-secrets.zsh`, source it, then:
#   printf 'CF_API_TOKEN=%s\n' "$CF_API_TOKEN" | sudo tee /etc/caddy/env >/dev/null
#   sudo chmod 600 /etc/caddy/env && sudo chown caddy:caddy /etc/caddy/env
#
# Cloudflare token scope required: Zone:DNS:Edit on webfront.app.

CF_API_TOKEN=cloudflare-api-token-goes-here
