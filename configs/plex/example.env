# Plex Media Server — makemake. Copy to .env (mode 600) and fill in.
# .env holds the claim token and is NEVER tracked in the infra repo
# (infra AGENTS.md: "No secrets ever in this repo").

# --- storage -----------------------------------------------------------
# Library database + metadata. On btrfs root, so this directory carries
# `chattr +C` (nodatacow) to stop CoW fragmenting Plex's SQLite database.
PLEX_CONFIG_DIR=/home/ctaylor/plex/config

# Media root. Bind-mounted read-only as /media/{movies,tv,music}.
# This is a SYMLINK to /mnt/expansion/media (1.3 TB external USB, exfat).
# Kept as a $HOME path so the manifest can carry it as a path: artifact --
# converge then reports MISSING when the drive is not mounted.
MEDIA_DIR=/home/ctaylor/media

# --- identity ----------------------------------------------------------
TZ=Australia/Brisbane
PLEX_UID=1000
PLEX_GID=1000

# One-shot server claim token from https://plex.tv/claim — binds this
# server to your Plex account and enables plex.tv remote access.
# EXPIRES 4 MINUTES AFTER IT IS ISSUED: fetch it immediately before the
# first `docker compose up`. It is consumed on first successful start;
# blank it out afterwards (a stale token is ignored, not fatal).
PLEX_CLAIM=

# Direct-connection candidates handed to Plex clients, so apps prefer a
# LAN/tailnet route over the plex.tv relay. Order matters: wired office LAN
# first (line rate, same switch), then tailnet, then WiFi, then the Caddy
# https vhost on ceres as the named fallback.
ADVERTISE_IP=https://plex.wedrifid.dev:443/

# Networks Plex treats as local: direct play, no relay, no transcode
# downgrade. Tailnet CGNAT range + both LANs.
#
# TRADE-OFF: Plex's allowedNetworks ALSO waives login for these ranges, so
# anything on the tailnet or either LAN reaches the library unauthenticated.
# That matches the ceres Caddy site block (which aborts non-tailnet requests
# outright). Narrow or clear this if you want auth enforced on the LAN.
ALLOWED_NETWORKS=
