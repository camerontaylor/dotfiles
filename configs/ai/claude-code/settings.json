{
  "cleanupPeriodDays": 90,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_SHELL": "zsh",
    "ENABLE_LSP_TOOL": "0",
    "LANGFUSE_HOST": "https://telemetry.webfront.app",
    "LANGFUSE_PUBLIC_KEY": "pk-lf-local-claude-code",
    "TRACE_TO_LANGFUSE": "true"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(less:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(stat:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(yarn list:*)",
      "Bash(yarn info:*)",
      "Bash(yarn why:*)",
      "Bash(npm list:*)",
      "Bash(npm view:*)",
      "Bash(npm ls:*)",
      "Bash(npm explain:*)",
      "Bash(npm outdated:*)",
      "Bash(node -e:*)",
      "Bash(node -p:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(pwd:*)",
      "Bash(env:*)",
      "Bash(echo:*)",
      "Bash(type:*)",
      "Bash(command:*)",
      "Read",
      "Bash(node -e \"require\\(''./.eslintrc.js''\\)\")",
      "Glob",
      "Grep",
      "LS",
      "NotebookRead",
      "TodoRead",
      "Bash(yarn remove:*)",
      "Bash(npm install:*)",
      "Bash(chmod:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(yarn add:*)",
      "Bash(yarn test:*)",
      "Bash(git stash:*)",
      "Bash(yarn jest:*)",
      "Bash(xargs:*)",
      "Bash(node --version:*)",
      "Bash(SKIP_SLOW=true yarn eslint:*)",
      "Bash(claude plugin uninstall:*)",
      "Bash(claude plugin install:*)",
      "Bash(source ~/.nvm/nvm.sh)",
      "Bash(nvm list:*)",
      "Bash(nvm use:*)",
      "Bash(nvm install:*)",
      "Bash(nvm alias:*)",
      "Bash(uvx:*)",
      "Bash(yarn eslint:*)",
      "Bash(done)",
      "Bash(while read f)",
      "Bash(do echo \"=== $f ===\")",
      "Bash(python3:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__exa__get_code_context_exa",
      "mcp__exa__web_search_exa",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "Skill(commit-commands:commit)",
      "Bash(paseo ls:*)",
      "Bash(paseo inspect:*)",
      "Bash(paseo logs:*)",
      "Bash(paseo wait:*)",
      "Bash(paseo send:*)",
      "Bash(paseo permit ls:*)",
      "Bash(paseo permit allow:*)",
      "Bash(paseo permit deny:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-commit-reformat-notice.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/hart-agent-homes/tools/distiller/hooks/navigation-read.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/hart-agent-homes/tools/distiller/hooks/session-end.sh",
            "timeout": 15,
            "statusMessage": "Distilling session into skill library"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repos/hart-agent-homes/tools/distiller/hooks/user-prompt-submit.sh",
            "timeout": 10,
            "statusMessage": "Checking distilled skill library"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "gitlab@claude-plugins-official": false,
    "memsearch@memsearch-plugins": false,
    "engram@engram": false,
    "code-simplifier@claude-plugins-official": false,
    "storybook-assistant@storybook-assistant": false,
    "skill-creator@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "jamie-bitflight-skills": {
      "source": {
        "source": "github",
        "repo": "Jamie-BitFlight/claude_skills"
      }
    },
    "cavekit-local": {
      "source": {
        "source": "directory",
        "path": "/home/ctaylor/.claude/plugins/local/cavekit-marketplace"
      }
    }
  },
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
