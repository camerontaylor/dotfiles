{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/omx-user-filtered-hook.mjs SessionStart",
            "statusMessage": "OMX user-owned filtered SessionStart hook"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/omx-user-filtered-hook.mjs PreToolUse",
            "statusMessage": "OMX user-owned filtered PreToolUse hook"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/omx-user-filtered-hook.mjs UserPromptSubmit",
            "statusMessage": "OMX user-owned filtered UserPromptSubmit hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/omx-user-filtered-hook.mjs Stop",
            "statusMessage": "OMX user-owned filtered Stop hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/hooks/git-commit-reformat-notice.sh",
            "statusMessage": "git commit reformat notice"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/hooks/omx-user-filtered-hook.mjs PostToolUse",
            "statusMessage": "OMX user-owned filtered PostToolUse hook"
          }
        ]
      }
    ]
  }
}
