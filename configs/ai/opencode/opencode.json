{
  "$schema": "https://opencode.ai/config.json",

  "//": "Single-model setup: OpenRouter stealth/ox-alpha, same model ccx-direct pins (zsh/env.d/09_claude_code_aliases.zsh). Free while in stealth trial; listed 2026-08-16, expect the free window to END ~2026-08-28. Data policy (per OpenRouter, 2026-08-21): prompts+completions ARE retained by the anonymous provider, NOT used for training -- never point this at personal/court/triage data. When the model starts 404ing the trial is over: drop the provider block below and pick a real model.",

  "model": "openrouter/stealth/ox-alpha",
  "small_model": "openrouter/stealth/ox-alpha",
  "enabled_providers": ["openrouter"],

  "provider": {
    "openrouter": {
      "whitelist": ["stealth/ox-alpha"],
      "options": {
        "timeout": 3000000
      },
      "models": {
        "stealth/ox-alpha": {
          "name": "Ox Alpha (stealth)",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 1048576, "output": 131072 }
        }
      }
    }
  },

  "mcp": {
    "repomapper": {
      "type": "local",
      "command": [
        "/home/ctaylor/.local/bin/repomap-mcp"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "web-to-mcp": {
      "type": "remote",
      "url": "https://web-to-mcp.com/mcp/541f0cbf-c5e3-4e77-9170-885d742bb4bf/",
      "enabled": true,
      "timeout": 120000
    }
  },

  "plugin": [
    "opencode-antigravity-auth@1.6.0",
    "opencode-beads"
  ],

  "tools": {
    "webfetch": false,
    "exa_*": false,
    "context7_*": false,
    "google_*": false,
    "websearch_*": false
  },

  "permission": {
    "webfetch": "deny",
    "exa_*": "deny",
    "context7_*": "deny",
    "google_*": "deny",
    "websearch_*": "deny"
  }
}
