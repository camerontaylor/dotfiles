#compdef ao

_ao_dynamic_describe() {
  local tag="$1"
  local label="$2"
  local kind="$3"
  shift 3

  local -a items
  local value description
  while IFS=$'\t' read -r value description; do
    [[ -n "$value" ]] || continue
    if [[ -n "$description" ]]; then
      description=${description//:/\\:}
      items+=("${value}:${description}")
    else
      items+=("${value}")
    fi
  done < <(command ao __complete "$kind" "$@" 2>/dev/null)

  (( ${#items[@]} )) || return 1
  _describe -t "$tag" "$label" items
}

_ao_complete_projects() {
  _ao_dynamic_describe projects "configured project" projects
}

_ao_complete_sessions() {
  _ao_dynamic_describe sessions "active session" sessions
}

_ao_complete_all_sessions() {
  _ao_dynamic_describe sessions "session" sessions --include-terminated
}

_ao_complete_open_targets() {
  _ao_dynamic_describe targets "open target" open-targets
}

_ao_complete_start_target() {
  _alternative \
    'projects:configured project:_ao_complete_projects' \
    'paths:path:_files'
}

_ao_complete_plugin_slots() {
  local -a slots
  slots=(
        'runtime:Execution runtime plugins'
        'agent:Worker/orchestrator agent plugins'
        'workspace:Workspace isolation plugins'
        'tracker:Issue tracker plugins'
        'scm:Source control plugins'
        'notifier:Notification plugins'
        'terminal:Terminal attachment plugins'
  )
  _describe -t plugin-slots "plugin slot" slots
}

_ao_complete_report_states() {
  local -a states
  states=(
        'started:Session picked up'
        'working:Actively making progress'
        'waiting:Waiting on an external dependency'
        'needs-input:Needs human input'
        'fixing-ci:Working on CI failures'
        'addressing-reviews:Working on review feedback'
        'pr-created:Created a PR'
        'draft-pr-created:Created a draft PR'
        'ready-for-review:PR is ready for review'
        'completed:Finished non-PR work'
  )
  _describe -t report-states "report state" states
}

_ao() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local subcommand_name="${words[2]-}"
  case "$subcommand_name" in
    'init' )
      _ao_init
      return
      ;;
    'start' )
      _ao_start
      return
      ;;
    'stop' )
      _ao_stop
      return
      ;;
    'status' )
      _ao_status
      return
      ;;
    'spawn' )
      _ao_spawn
      return
      ;;
    'batch-spawn' )
      _ao_batch_spawn
      return
      ;;
    'session' )
      _ao_session
      return
      ;;
    'send' )
      _ao_send
      return
      ;;
    'acknowledge' )
      _ao_acknowledge
      return
      ;;
    'report' )
      _ao_report
      return
      ;;
    'review-check' )
      _ao_review_check
      return
      ;;
    'dashboard' )
      _ao_dashboard
      return
      ;;
    'open' )
      _ao_open
      return
      ;;
    'verify' )
      _ao_verify
      return
      ;;
    'doctor' )
      _ao_doctor
      return
      ;;
    'update' )
      _ao_update
      return
      ;;
    'setup' )
      _ao_setup
      return
      ;;
    'plugin' )
      _ao_plugin
      return
      ;;
    'project' )
      _ao_project
      return
      ;;
    'migrate-storage' )
      _ao_migrate_storage
      return
      ;;
    'completion' )
      _ao_completion
      return
      ;;
    'events' )
      _ao_events
      return
      ;;
    'config-help' )
      _ao_config_help
      return
      ;;
  esac
  _arguments -C \
    '-V[output the version number]' \
    '--version[output the version number]' \
    '1:command:->subcommand'
  case $state in
    subcommand)
      local -a subcommands
      subcommands=(
        'init:[deprecated] Use '\''ao start'\'' instead — it auto-creates config on first run'
        'start:Start orchestrator agent and dashboard (auto-creates config on first run, adds projects by path/URL)'
        'stop:Stop orchestrator agent and dashboard'
        'status:Show all sessions with branch, activity, PR, and CI status'
        'spawn:Spawn a single agent session'
        'batch-spawn:Spawn sessions for multiple issues with duplicate detection'
        'session:Session management (ls, kill, cleanup, restore, claim-pr)'
        'send:Send a message to a session with busy detection and retry'
        'acknowledge:Acknowledge session pickup — agents run this once after reading the initial prompt (Stage 3).'
        'report:Declare a workflow transition (Stage 3). Allowed states\\: started, working, waiting, needs_input, fixing_ci, addressing_reviews, pr_created, draft_pr_created, ready_for_review, completed (hyphenated aliases accepted).'
        'review-check:Check PRs for review comments and trigger agents to address them'
        'dashboard:Start the web dashboard'
        'open:Open session(s) in terminal tabs'
        'verify:Mark an issue as verified (or failed) after checking the fix on staging'
        'doctor:Run install, environment, and runtime health checks'
        'update:Check for updates and upgrade AO to the latest version'
        'setup:Set up integrations with external services'
        'plugin:Browse and manage AO plugins'
        'project:Manage portfolio projects'
        'migrate-storage:Migrate storage from legacy hash-based layout to projects/{projectId}/ layout'
        'completion:Generate shell completion scripts'
        'events:Query activity event log (session spawns, transitions, CI failures)'
        'config-help:Show config schema and guide for creating agent-orchestrator.yaml'
      )
      _describe -t commands 'ao command' subcommands
      return
      ;;
  esac
}

