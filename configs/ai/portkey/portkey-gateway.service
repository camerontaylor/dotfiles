[Unit]
Description=Portkey Gateway local-mode fork
Documentation=file:/home/ctaylor/repos/webfront/docs/llm_gateway.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/dotfiles/configs/ai/portkey
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%S/portkey/env
Environment=PORT=8787
Environment=PORTKEY_API_KEY=%h/.local/state/portkey/local-api-key
Environment=PORTKEY_LOCAL_API_KEY=%h/.local/state/portkey/local-api-key
Environment=FETCH_SETTINGS_FROM_FILE=true
Environment=PORTKEY_LOCAL_MODE=true
Environment=PORTKEY_TELEMETRY=false
Environment=DISABLE_ANALYTICS=true
Environment=ENABLE_TRACING=false
Environment=MONITOR_METRICS=false
Environment=CACHE_STORE=memory
Environment=GATEWAY_CACHE_MODE=memory
ExecStartPre=/usr/bin/test -r /home/ctaylor/repos/portkey-gateway/build/start-server.js
ExecStartPre=/usr/bin/test -r %h/.local/dotfiles/configs/ai/portkey/config.json
ExecStartPre=/usr/bin/sh -c 'test -e "$HOME/.local/dotfiles/configs/ai/portkey/conf.json" || ln -s "$HOME/.local/dotfiles/configs/ai/portkey/config.json" "$HOME/.local/dotfiles/configs/ai/portkey/conf.json"'
ExecStart=/usr/bin/env node /home/ctaylor/repos/portkey-gateway/build/start-server.js --llm-node --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
