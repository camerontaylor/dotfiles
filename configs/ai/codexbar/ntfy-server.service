[Unit]
Description=ntfy server (quota cue delivery)
Documentation=https://docs.ntfy.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/test -x %h/.local/share/ntfy/ntfy
ExecStart=%h/.local/share/ntfy/ntfy serve --config %h/.config/ntfy/server.yml
Restart=on-failure
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/ntfy %h/.config/ntfy
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
MemoryMax=512M

[Install]
WantedBy=default.target
