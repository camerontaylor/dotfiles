[Unit]
Description=Quota pacing cues (CodexBar -> ntfy)
After=codexbar-serve.service ntfy-server.service
Wants=codexbar-serve.service ntfy-server.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/dotfiles/scripts/codexbar-quota-cues.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/codexbar-alerts
