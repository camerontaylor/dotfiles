[include]
	path = local/user
	path = local/stuff
[pull]
	# Rebase-on-pull keeps history linear and avoids "merge made by recursive"
	# noise. Rest of this config already leans rebase-friendly (rebase.autoSquash,
	# rerere.enabled). Override per-repo if needed: `git config pull.rebase false`.
	rebase = true
[init]
	defaultBranch = main
[push]
	default = simple
	followTags = true
	autoSetupRemote = true
[commit]
	verbose = true
[branch]
	sort = -committerdate
	autoSetupRebase = never
[tag]
	sort = version:refname
[merge]
	conflictstyle = zdiff3
	tool = nvimdiff
	ff = true
[rebase]
	autoSquash = true
[credential]
	helper = cache --socket ~/.cache/git-credential-cache/socket
[diff]
	algorithm = histogram
	ignoreSubmodules = dirty
	submodule = log
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	renamelimit = 20000
[core]
	excludesFile = ~/.config/git/ignore
	autocrlf = input
	whitespace = cr-at-eol
	pager = less --quit-if-one-screen
[pager]
	diff = git-diff-pager
	show = git-diff-pager
	log = git-diff-pager
	blame = git-diff-pager
	stash = git-diff-pager
[submodule]
	fetchJobs = 32
	# Master switch for auto-recursion (pull, push, checkout, switch, status).
	# Off by default — opt in per-command with `--recurse-submodules` when needed.
	recurse = false
[status]
	submoduleSummary = true
[rerere]
	enabled = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[delta]
	pager = less --RAW-CONTROL-CHARS --quit-if-one-screen
	navigate = true
	hyperlinks = true
	dark = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Solarized (dark)

# vi: ft=gitconfig
[user]
	email = camerontaylor@gmail.com
	name = Cameron Taylor
[merge "ours"]
	driver = true
[http]
	postbuffer = 524288000
[advice]
	diverging = true
[fetch]
	parallel = 32
[checkout]
	workers = 16
[url "git@github.com:"]
	insteadOf = https://github.com/
[coderabbit]
	machineId = cli/b3691d24787149248d400912f75f04ac
