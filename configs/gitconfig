[include]
	path = local/user
	path = local/stuff
[pull]
	rebase = false
[init]
	defaultBranch = main
[push]
	default = simple
	followTags = true
	autoSetupRemote = true
[commit]
	verbose = true
[branch]
	sort = -committerdate
	autoSetupRebase = never
[tag]
	sort = version:refname
[merge]
	conflictstyle = zdiff3
	tool = nvimdiff
	ff = true
[rebase]
	autoSquash = true
[credential]
	helper = cache --socket ~/.cache/git-credential-cache/socket
[diff]
	algorithm = histogram
	ignoreSubmodules = dirty
	submodule = log
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	renamelimit = 20000
[core]
	excludesFile = ~/.config/git/ignore
	autocrlf = input
	whitespace = cr-at-eol
	pager = less --quit-if-one-screen
[pager]
	diff = git-diff-pager
[submodule]
	fetchJobs = 32
	recurse = true
[status]
	submoduleSummary = true
[rerere]
	enabled = true
[delta]
	pager = less
	navigate = true
	hyperlinks = true
	dark = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Solarized (dark)

# vi: ft=gitconfig
[user]
	email = camerontaylor@gmail.com
	name = Cameron Taylor
[merge "ours"]
	driver = true
[http]
	postbuffer = 524288000
[advice]
	diverging = true
[fetch]
	parallel = 32
[checkout]
	workers = 16
