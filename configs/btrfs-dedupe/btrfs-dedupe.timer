# Tracked source of truth for /etc/systemd/system/btrfs-dedupe.timer.
# Installed by scripts/setup-btrfs-dedupe.sh — do not hand-edit the live unit.
[Unit]
Description=Monthly btrfs deduplication

[Timer]
# First of the month. Monthly (not weekly) because the incremental run is cheap
# but not free: ~3 min of pure stat(2) walk over 6.2M files plus loading a 3.1GB
# hashfile, even when there is nothing at all to dedupe.
OnCalendar=monthly
# Do not have every fleet box start hammering its disk at 00:00 on the 1st.
RandomizedDelaySec=6h
# Catch up if the box was off when the timer was due.
Persistent=true
AccuracySec=1h

[Install]
WantedBy=timers.target
