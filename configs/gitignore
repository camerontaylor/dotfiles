### OS ###
# MacOS
# Everything here is metadata the OS writes next to your files. None of it is
# ever a property of a repo, which is why it all belongs in the global ignore
# rather than in any project .gitignore.
.DS_Store
.AppleDouble
.LSOverride

# AppleDouble sidecars. macOS falls back to these only on filesystems that
# cannot store extended attributes: exFAT/FAT32 (USB sticks, camera cards) and
# SMB/NFS shares, plus archives round-tripped through them. APFS and HFS+ store
# xattrs natively and never produce them, so these arrive by transfer rather
# than from any local disk. Broad pattern, but a real source file named ._foo
# does not exist.
._*

# Spotlight opt-out markers. Dropping one in a directory tells mds not to index
# that subtree, so they get created by hand (or by tooling) in big checkouts to
# keep node_modules out of the index. The _unless_rootfs variant is the same
# switch, ignored when the subtree happens to be the boot volume.
.metadata_never_index
.metadata_never_index_unless_rootfs

# Written at the root of a volume, so these only surface when a repo lives
# directly on one rather than in a subdirectory.
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# AFP/SMB network share artifacts.
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### oh-my-claudecode / OMC / sisyphus (copied from webfront/.gitignore) ###
# Ignore root .omc by default, then allowlist meaningful artifacts
.omc/*

# Ignore any nested .omc directories outright (keep root /.omc managed below)
**/.omc/
!/.omc/

# Keep meaningful agent knowledge artifacts
!/.omc/plans/
!/.omc/plans/**
!/.omc/research/
!/.omc/research/**
!/.omc/notepad.md
!/.omc/skills/
!/.omc/skills/**
!/.omc/templates/
!/.omc/templates/**
!/.omc/specs/
!/.omc/specs/**

# Ignore high-churn runtime artifacts in root .omc
/.omc/state/
/.omc/sessions/
/.omc/**/*.jsonl
/.omc/**/*.log

# Specific files inside allowlisted dirs that should still be ignored
.omc/plans/open-questions.md

### distilled skill library (.agent/ — successor to .omc/, renamed 2026-08-29) ###
# The distiller (hart-agent-homes/tools/distiller) writes $cwd/.agent/skills +
# skills-pending/ + .distiller/ into every repo an agent works in. Ignore the
# CONTENTS, never the `.agent` directory itself: hart's own .gitignore re-includes
# `.agent/skills/` as tracked, and excluding the directory here would silently stop
# git from descending into it.
**/.agent/*

# Sisyphus boulder state
.sisyphus/boulder.json

# Gajae Code (gjc) writes per-session state into every project it runs in
.gjc/

# gjc's exact-edit scratch files, dropped NEXT TO the file being edited rather
# than inside .gjc/, so the rule above does not catch them. Named
# .gjc-exact-<op>-<hash>-<id>, mostly 0 bytes, and they are not cleaned up: 16
# had piled into configs/ai/gjc/ on neptune by 2026-08-31, several appearing
# mid-session. Two ops seen so far (replace-destination, unlink-placeholder);
# the prefix covers any others.
.gjc-exact-*

