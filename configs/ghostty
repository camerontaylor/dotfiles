theme = iTerm2 Solarized Dark
palette-generate = false
# Tried 2026-11-01 on a 1080p VGA external: helps small text, bloats large
# text at the default strength (255). Size is boosted via cmux
# globalFontMagnification instead. font-thicken-strength (0-255) is the
# middle ground if revisited.
font-thicken = false
shell-integration = none
shell-integration-features = cursor,path,title,sudo,ssh-env,no-ssh-terminfo
confirm-close-surface = false
keybind = alt+left=unbind
keybind = alt+right=unbind
mouse-hide-while-typing = true
window-padding-balance = true
bell-features = no-attention
link-previews = true

config-file = ?config-local


window-save-state = always
#cursor-style = bar
#cursor-style-blink = false
scrollback-limit = 50000
keybind = global:ctrl+grave_accent=toggle_quick_terminal


linux-cgroup = single-instance
window-vsync = true
