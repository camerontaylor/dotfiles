    "fleet-sonnet": {
      "description": "Workhorse route: intended weighted Fireworks GLM-5.1 plus Z.AI, with MiniMax and Kimi fallbacks.",
      "portkey_config": {
        "strategy": {
          "mode": "fallback",
          "on_status_codes": [
            408,
            429,
            500,
            502,
            503,
            504,
            529
          ]
        },
        "retry": {
          "attempts": 2,
