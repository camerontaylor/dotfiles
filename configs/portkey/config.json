            500,
            502,
            503,
            504,
            529
          ],
          "use_retry_after_header": true
        },
        "request_timeout": 75000,
        "targets": [
          {
            "strategy": {
              "mode": "loadbalance",
              "sticky": {
                "enabled": true,
                "hash_fields": [
                  "metadata.portkey_session",
                  "params.model"
                ],
                "ttl": 3600
              }
            },
            "targets": [
              {
                "provider": "anthropic",
                "api_key_env": "FIREWORKS_API_KEY",
                "override_params": {
                  "model": "accounts/fireworks/models/glm-5p1"
                },
                "weight": 3,
                "request_timeout": 45000,
                "custom_host": "https://api.fireworks.ai/inference/v1"
              },
              {
                "provider": "anthropic",
                "api_key_env": "Z_AI_API_KEY",
                "custom_host": "https://api.z.ai/api/anthropic/v1",
                "override_params": {
                  "model": "glm-5.1"
                },
                "weight": 2,
                "request_timeout": 45000
              }
            ]
          },
          {
            "provider": "anthropic",
