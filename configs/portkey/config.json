{
  "routes": {
    "fleet-count-tokens": {
      "description": "Token counting validation route kept on Anthropic-compatible providers; Fireworks/Cerebras count_tokens remains a cutover gate.",
      "portkey_config": {
        "strategy": {
          "mode": "fallback",
          "on_status_codes": [
            408,
            429,
            500,
            502,
            503,
            504,
            529
          ]
        },
        "retry": {
          "attempts": 2,
          "on_status_codes": [
            408,
            429,
            500,
            502,
            503,
            504,
            529
          ],
          "use_retry_after_header": true
        },
        "request_timeout": 30000,
        "targets": [
          {
            "provider": "anthropic",
            "api_key_env": "Z_AI_API_KEY",
            "custom_host": "https://api.z.ai/api/anthropic/v1",
            "override_params": {
              "model": "glm-5.1"
            },
            "request_timeout": 30000
          },
          {
            "provider": "anthropic",
            "api_key_env": "MINIMAX_API_KEY",
            "custom_host": "https://api.minimax.io/anthropic/v1",
            "override_params": {
              "model": "MiniMax-M2.7"
            },
            "request_timeout": 30000
          }
        ]
      }
    },
