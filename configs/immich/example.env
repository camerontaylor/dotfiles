# Immich stack environment — TEMPLATE. Copy to ~/repos/deploy/immich/.env and
# fill the marked values. `scripts/setup-immich.sh` does the copy for you and
# then refuses to finish until the CHANGEME placeholders are gone.
#
# NOTHING REAL GOES IN THIS FILE. It lives in the PUBLIC camerontaylor/dotfiles
# repo. Real values belong in the untracked .env on the host (and, for the
# restic/B2 credentials, in the private camerontaylor/dotfiles-secrets repo —
# see docs/immich.md).
#
# Upstream reference for every supported variable:
# https://docs.immich.app/install/environment-variables

# ── Storage ────────────────────────────────────────────────────────────────
# Where uploaded originals live. On ceres this is an absolute path outside the
# deploy dir (~/immich/library) because that tree is what restic snapshots.
UPLOAD_LOCATION=./library

# Database files. Network shares are NOT supported for the database.
DB_DATA_LOCATION=./postgres

# ── Runtime ────────────────────────────────────────────────────────────────
# TZ identifier from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Pin to a major line ("v3") or an exact release ("v3.1.0").
IMMICH_VERSION=v3

# Comma-separated proxy addresses whose X-Forwarded-For header is believed.
# Set this when something fronts Immich (on ceres, Caddy at
# immich.wedrifid.dev). Host-originated traffic to the published port arrives
# from the docker bridge gateway, so that gateway address is what goes here —
# find it with: docker network inspect immich_default -f '{{(index .IPAM.Config 0).Gateway}}'
# Leave empty when nothing fronts the stack.
IMMICH_TRUSTED_PROXIES=

# ── Secrets ────────────────────────────────────────────────────────────────
# Postgres connection secret. Characters A-Za-z0-9 only, no spaces or symbols.
# NOTE: this is baked into the postgres data directory on first init. Changing
# it later requires an ALTER USER inside the running container, not just an
# edit here — see docs/immich.md.
DB_PASSWORD=CHANGEME

# Hugging Face token, used by immich_machine_learning to pull gated models.
# Leave empty if you only use ungated models.
HF_TOKEN=

# ── Fixed ──────────────────────────────────────────────────────────────────
# The values below this line do not need to be changed.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
