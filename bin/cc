#!/usr/bin/env bash
# cc — webfront-dispatched plain-Anthropic Claude Code session.
# Bash twin of zsh/fpath/cc. Outside a webfront repo: direct `claude` with
# every fleet-routing override unset — the exec-env spelling of the _cc
# fallback in zsh/env.d/09_claude_code_aliases.zsh (keep the var lists in
# sync).
_wfr="$(dirname "$0")/webfront-root"
root=$("$_wfr") || {
    exec env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY \
        -u ANTHROPIC_CUSTOM_HEADERS -u ANTHROPIC_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL \
        -u ANTHROPIC_DEFAULT_SONNET_MODEL -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
        -u ANTHROPIC_SMALL_FAST_MODEL -u CLAUDE_CODE_SUBAGENT_MODEL -u API_TIMEOUT_MS \
        -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -u ENABLE_TOOL_SEARCH \
        CLAUDE_CODE_ATTRIBUTION_HEADER=0 claude "$@"
}
exec zsh "$root/scripts/run-agent-alias.sh" cc "$@"
