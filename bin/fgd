#!/usr/bin/env bash
# fgd — git diff by files with fzf.
# Bash twin of zsh/fpath/fgd (${@:2} slice is native bash; ${+commands[x]}
# probes → command -v).
git rev-parse --is-inside-work-tree &> /dev/null || exit 0

_fgd_commit= _fgd_files=()
if [[ $# -ne 0 ]]; then
    if git rev-parse $1 -- &>/dev/null ; then
        _fgd_commit=$1 && _fgd_files=("${@:2}")
    else
        _fgd_files=("$@")
    fi
fi

if command -v delta >/dev/null 2>&1; then
    _fgd_hl='| delta'
elif command -v diff-so-fancy >/dev/null 2>&1; then
    _fgd_hl='| diff-so-fancy'
else
    _fgd_hl=''
fi

_fgd_repo=$(git rev-parse --show-toplevel)
_fgd_preview="xargs -I% git --no-pager diff --color=always $_fgd_commit -- '$_fgd_repo/%' <<< {} $_fgd_hl"

git --no-pager diff --name-only $_fgd_commit -- ${_fgd_files[*]} |
fzf --no-sort --tac --exit-0 --preview-window=right:50% --preview="$_fgd_preview"
