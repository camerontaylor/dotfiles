#!/bin/sh
# Enforce stable generated config defaults before commit.
# Runs on: git commit (pre-commit hook)
#
# This hook does NOT touch secrets. It once chained save-secrets.zsh --git-add,
# which re-encrypted every .enc file with fresh nonces on every commit — folding
# noise into unrelated commits and producing routine ssh/config.enc conflicts on
# stash/rebase. Both the chaining and the .enc files are gone: secrets live in
# the private repo at ~/.local/secrets and are edited with `secrets-edit`.
#
# POSIX sh (docs/bash-compatibility.md §D): a zsh-shebang hook would block
# every commit on a host without zsh. The staged file list moves through a
# temp file because POSIX sh has no <(...) process substitution, and a
# `while` fed from a pipeline would lose _gate_fail to its subshell.

set -e

# Hand-rolled symlink walk (the repo's canonical pattern, see
# scripts/generate-commit-msg) — zsh's ${0:A:h} has no POSIX spelling.
_self=$0
while [ -L "$_self" ]; do
    _self_dir=$(cd -P -- "$(dirname -- "$_self")" && pwd)
    _self=$(readlink "$_self")
    case $_self in
        /*) ;;
        *) _self=$_self_dir/$_self ;;
    esac
done
SCRIPT_DIR=$(cd -P -- "$(dirname -- "$_self")" && pwd)

# ── Dual-shell syntax gate for scripts/ ──────────────────────────────────
# The bootstrap layer must run under both zsh (deploy.zsh today) and bash
# 3.2 (the driver floor; see docs/bash-compatibility.md). The gate lives in
# scripts/tests/shell-syntax-gate.sh so CI runs the exact same logic
# tree-wide (--all) that the hook runs over staged files (--staged).
# --staged has zero exemptions: the bootstrap layer is fully dual by
# policy.
if ! "$SCRIPT_DIR/tests/shell-syntax-gate.sh" --staged; then
    exit 1
fi

exec "$SCRIPT_DIR/enforce-codex-defaults.zsh" --git-add
