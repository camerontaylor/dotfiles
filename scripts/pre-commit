#!/usr/bin/env zsh
# Enforce stable generated config defaults before commit.
# Runs on: git commit (pre-commit hook)
#
# Secrets re-encryption was previously chained here via save-secrets.zsh
# --git-add, but every commit re-encrypted all .enc files with fresh nonces
# even when plaintext hadn't changed — folding noise into unrelated commits
# and producing routine ssh/config.enc conflicts on stash/rebase. Run
# `./scripts/save-secrets.zsh` manually after editing a secret.

setopt err_exit

# Hand-rolled symlink walk (the repo's canonical pattern, see
# scripts/generate-commit-msg) — zsh's ${0:A:h} has no bash spelling.
_self=$0
while [[ -L $_self ]]; do
    _self_dir=$(cd -P -- "$(dirname -- "$_self")" && pwd)
    _self=$(readlink "$_self")
    [[ $_self != /* ]] && _self=$_self_dir/$_self
done
SCRIPT_DIR=$(cd -P -- "$(dirname -- "$_self")" && pwd)
exec $SCRIPT_DIR/enforce-codex-defaults.zsh --git-add
