#!/usr/bin/env bash
set -euo pipefail

# generate-commit-msg
#
# Shared core: takes a diff on stdin, generates a conventional commit message
# on stdout. Used by commit-conventional and rewrite-commits-conventional.
#
# Calls the Cerebras chat-completions API (Gemma 4) directly with curl — no
# Claude Code harness, no gateway. The API key comes from $CEREBRAS_API_KEY,
# falling back to the rendered secrets file at
# ${XDG_STATE_HOME:-$HOME/.local/state}/secrets/zsh/90_secrets.zsh for contexts
# (git hooks, cron) where zsh/env.d hasn't been sourced.
#
# Usage:
#   git diff --cached | generate-commit-msg
#   git diff-tree -p $hash | generate-commit-msg --context "auth refactor"
#   generate-commit-msg --help

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"

MODEL="${COMMIT_MODEL:-gemma-4-31b}"
BASE_URL="${COMMIT_BASE_URL:-https://api.cerebras.ai/v1}"
API_KEY="${COMMIT_API_KEY:-${CEREBRAS_API_KEY:-}}"
INCLUDE_BODY=false
EXTRA_CONTEXT=""
ORIGINAL_MSG=""
QUIET=false
MAX_RETRIES=2

# ── Conventional commit helpers ────────────────────────────────────────────

CC_PATTERN='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?!?:[[:space:]].+'

is_conventional() {
  local first_line
  first_line="$(echo "$1" | sed '/^[[:space:]]*$/d' | head -n1)"
  [[ "$first_line" =~ $CC_PATTERN ]]
}

strip_fences() {
  # Drop ``` fence lines, then trim leading/trailing blank lines.
  # awk avoids GNU-vs-BSD sed differences around {...} blocks and \n in regex.
  printf '%s\n' "$1" | awk '
    /^```/ { next }
    { lines[++n] = $0 }
    END {
      start = 1
      while (start <= n && lines[start] ~ /^[[:space:]]*$/) start++
      end = n
      while (end >= start && lines[end] ~ /^[[:space:]]*$/) end--
      for (i = start; i <= end; i++) print lines[i]
    }
  '
}

diagnose_conventional_failure() {
  local first_line
  first_line="$(echo "$1" | sed '/^[[:space:]]*$/d' | head -n1)"
  local reasons=()

  if ! [[ "$first_line" =~ ^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert) ]]; then
    reasons+=("missing or invalid type")
  fi
  if ! [[ "$first_line" =~ :[[:space:]] ]]; then
    reasons+=("missing ': ' separator")
  fi
  if [[ "$first_line" =~ ^\`\`\` ]]; then
    reasons+=("wrapped in markdown fences")
  fi
  if [[ "$first_line" =~ ^(Here|This|The|I\ ) ]]; then
    reasons+=("starts with explanation text")
  fi
  if [[ ${#reasons[@]} -eq 0 ]]; then
    reasons+=("first line does not match: type(scope)?: subject")
  fi

  local IFS='; '
  echo "${reasons[*]}"
}

# ── Usage ──────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: <diff source> | generate-commit-msg [options]

Generate a conventional commit message from a diff piped to stdin.
Outputs the commit message on stdout. Diagnostics go to stderr.

Options:
  --model <model>       Model id (default: gemma-4-31b)
  --body                Include a detailed commit body
  --context, -c <text>  Extra context to help the AI
  --original-msg <msg>  Original commit message (for rewrites)
  --quiet, -q           Suppress stderr diagnostics
  -h, --help            Show this help message

Environment:
  COMMIT_MODEL      Override the default model (default: gemma-4-31b)
  COMMIT_BASE_URL   OpenAI-compatible base URL (default: https://api.cerebras.ai/v1)
  COMMIT_API_KEY    API key (default: $CEREBRAS_API_KEY, then the rendered
                    $XDG_STATE_HOME/secrets/zsh/90_secrets.zsh)
  COMMIT_TELEMETRY  Set to "false" to skip Langfuse trace logging

Telemetry:
  Each run is logged as a Langfuse trace (one generation per API call) to
  $LANGFUSE_HOST (default: https://telemetry.webfront.app). Keys resolve from
  LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY, then LANGFUSE_INIT_PROJECT_*, then
  the rendered $XDG_STATE_HOME/secrets/zsh/92_telemetry_secrets.zsh.
  Best-effort: never blocks generation.

Examples:
  git diff --cached | generate-commit-msg
  git diff-tree -p abc123 | generate-commit-msg --original-msg "old msg"
  git diff HEAD~1 | generate-commit-msg --body -c "perf optimization"
EOF
}

# ── Parse arguments ────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)         MODEL="$2"; shift 2 ;;
    --body)          INCLUDE_BODY=true; shift ;;
    --context|-c)    EXTRA_CONTEXT="$2"; shift 2 ;;
    --original-msg)  ORIGINAL_MSG="$2"; shift 2 ;;
    --quiet|-q)      QUIET=true; shift ;;
    -h|--help)       usage; exit 0 ;;
    *)               echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

log() {
  if [[ "$QUIET" == false ]]; then
    echo "$@" >&2
  fi
}

# extract_secret <file> <KEY>
# Reads `export KEY=value` from a rendered secrets file and prints the
# value with exactly one symmetric quote pair stripped. Quote-agnostic:
# handles KEY=v, KEY="v" and KEY='v' (the renderer emits ${(qq)} single
# quotes). Pure POSIX parameter expansion — no GNU sed, no bashisms
# beyond what this script already uses.
extract_secret() {
  local file="$1" key="$2" val
  [[ -r "$file" ]] || return 1
  val="$(sed -n "s/^export ${key}=//p" "$file" | head -n1)"
  [[ -n "$val" ]] || return 1
  case "$val" in
    \'*\')  val="${val#?}"; val="${val%?}"; val="${val//\'\\\'\'/\'}" ;;
    \"*\")  val="${val#?}"; val="${val%?}" ;;
  esac
  printf '%s\n' "$val"
}

# ── Resolve dependencies and API key ───────────────────────────────────────

for tool in curl jq; do
  if ! command -v "$tool" &>/dev/null; then
    echo "ERROR: '$tool' not found in PATH." >&2
    exit 1
  fi
done

if [[ -z "$API_KEY" ]]; then
  # Git hooks and cron run without the interactive env; pull the key straight
  # out of the secrets fragment instead of sourcing a zsh file from bash.
  SECRETS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/secrets/zsh/90_secrets.zsh"
  API_KEY="$(extract_secret "$SECRETS_FILE" CEREBRAS_API_KEY || true)"
fi

if [[ -z "$API_KEY" ]]; then
  echo "ERROR: No API key. Set CEREBRAS_API_KEY (or COMMIT_API_KEY)." >&2
  exit 1
fi

# ── Telemetry config (Langfuse) ────────────────────────────────────────────
# Direct API calls bypass the Claude Code harness, so nothing lands in the
# session transcripts the langfuse hook mines. Report each run ourselves via
# the Langfuse ingestion API instead. Best-effort only: missing keys or a
# down telemetry stack silently disable it — never block a commit.

TELEMETRY_HOST="${LANGFUSE_HOST:-https://telemetry.webfront.app}"
TELEMETRY_ENABLED=true
case "${COMMIT_TELEMETRY:-}" in
  0|false|off) TELEMETRY_ENABLED=false ;;
esac

LF_PUBLIC_KEY="${LANGFUSE_PUBLIC_KEY:-${LANGFUSE_INIT_PROJECT_PUBLIC_KEY:-}}"
LF_SECRET_KEY="${LANGFUSE_SECRET_KEY:-${LANGFUSE_INIT_PROJECT_SECRET_KEY:-}}"
if [[ "$TELEMETRY_ENABLED" == true && ( -z "$LF_PUBLIC_KEY" || -z "$LF_SECRET_KEY" ) ]]; then
  TELEMETRY_SECRETS="${XDG_STATE_HOME:-$HOME/.local/state}/secrets/zsh/92_telemetry_secrets.zsh"
  [[ -n "$LF_PUBLIC_KEY" ]] || LF_PUBLIC_KEY="$(extract_secret "$TELEMETRY_SECRETS" LANGFUSE_INIT_PROJECT_PUBLIC_KEY || true)"
  [[ -n "$LF_SECRET_KEY" ]] || LF_SECRET_KEY="$(extract_secret "$TELEMETRY_SECRETS" LANGFUSE_INIT_PROJECT_SECRET_KEY || true)"
fi
if [[ -z "$LF_PUBLIC_KEY" || -z "$LF_SECRET_KEY" ]]; then
  TELEMETRY_ENABLED=false
fi

# ── API call ───────────────────────────────────────────────────────────────

RESPONSE_FILE="$(mktemp -t generate-commit-msg.response.XXXXXX)"
HEADER_FILE="$(mktemp -t generate-commit-msg.headers.XXXXXX)"
cleanup() {
  rm -f "$RESPONSE_FILE" "$HEADER_FILE"
}
trap cleanup EXIT

chmod 600 "$HEADER_FILE"
# Key goes via a header file, not argv, so it never shows in the process list.
printf 'Authorization: Bearer %s\n' "$API_KEY" > "$HEADER_FILE"

# Sends one user message, prints the completion text on stdout.
# One retry on transport failure / 429 / 5xx; hard fail on other statuses.
call_api() {
  local prompt="$1" body http_code attempt
  body="$(jq -n --arg model "$MODEL" --arg prompt "$prompt" \
    '{model: $model, messages: [{role: "user", content: $prompt}], max_tokens: 2000, temperature: 0.2}')"

  for attempt in 1 2; do
    http_code="$(curl -sS -o "$RESPONSE_FILE" -w '%{http_code}' \
      --connect-timeout 5 --max-time 90 \
      -H @"$HEADER_FILE" \
      -H 'Content-Type: application/json' \
      -d "$body" \
      "$BASE_URL/chat/completions")" || http_code=000

    if [[ "$http_code" =~ ^2 ]]; then
      break
    fi
    if [[ "$attempt" -lt 2 && ( "$http_code" == "000" || "$http_code" == "429" || "$http_code" =~ ^5 ) ]]; then
      log "API request failed (HTTP $http_code), retrying..."
      sleep 2
      continue
    fi
    echo "ERROR: API request failed (HTTP $http_code): $(jq -r '.error.message // .error // empty' "$RESPONSE_FILE" 2>/dev/null | head -c 300)" >&2
    return 1
  done

  jq -r '.choices[0].message.content // empty' "$RESPONSE_FILE"
}

# ── Telemetry helpers ──────────────────────────────────────────────────────

iso_now() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

gen_uuid() {
  if command -v uuidgen &>/dev/null; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  else
    od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
  fi
}

TRACE_ID="$(gen_uuid)"
TELEMETRY_BATCH='[]'

# Append one generation-create event to the batch. call_api runs in a command
# substitution (subshell), so this must be called from the parent shell; token
# usage is read back from RESPONSE_FILE, which the subshell shares.
record_generation() {
  local name="$1" prompt="$2" output="$3" start="$4" end="$5"
  [[ "$TELEMETRY_ENABLED" == true ]] || return 0

  local usage gen_id
  usage="$(jq -c '{input: (.usage.prompt_tokens // null), output: (.usage.completion_tokens // null), total: (.usage.total_tokens // null), unit: "TOKENS"}' "$RESPONSE_FILE" 2>/dev/null)" || usage='null'
  gen_id="$(gen_uuid)"

  TELEMETRY_BATCH="$(jq -c \
    --arg id "$gen_id" --arg trace "$TRACE_ID" --arg name "$name" \
    --arg model "$MODEL" --arg prompt "$prompt" --arg output "$output" \
    --arg start "$start" --arg end "$end" --argjson usage "$usage" \
    '. + [{id: $id, type: "generation-create", timestamp: $end, body: {
       id: $id, traceId: $trace, name: $name, model: $model,
       input: $prompt, output: $output,
       startTime: $start, endTime: $end, usage: $usage}}]' \
    <<<"$TELEMETRY_BATCH")" || return 0
}

# POST the trace + accumulated generations to the Langfuse ingestion API.
# Fire-and-forget: the curl is backgrounded so a slow or unreachable
# telemetry stack never delays the interactive flow. Auth goes to the child
# via a pipe (curl -K -), keeping the secret out of argv and temp files.
send_telemetry() {
  [[ "$TELEMETRY_ENABLED" == true && "$TELEMETRY_BATCH" != '[]' ]] || return 0

  local now repo payload
  now="$(iso_now)"
  repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  repo="${repo##*/}"

  payload="$(jq -c -n \
    --arg id "$(gen_uuid)" --arg trace "$TRACE_ID" --arg now "$now" \
    --arg repo "$repo" --arg model "$MODEL" \
    --arg host "$(hostname -s 2>/dev/null || echo unknown)" \
    --arg output "$GENERATED_MSG" --argjson events "$TELEMETRY_BATCH" \
    '{batch: ([{id: $id, type: "trace-create", timestamp: $now, body: {
       id: $trace, timestamp: $now, name: "generate-commit-msg",
       output: $output, tags: ["generate-commit-msg", $repo],
       metadata: {source: "generate-commit-msg", model: $model,
                  repo: $repo, host: $host}}}] + $events)}')" || return 0

  printf 'user = "%s:%s"\n' "$LF_PUBLIC_KEY" "$LF_SECRET_KEY" | curl -s -o /dev/null \
    --connect-timeout 2 --max-time 5 -K - \
    -H 'Content-Type: application/json' \
    -d "$payload" \
    "$TELEMETRY_HOST/api/public/ingestion" &>/dev/null &

  log "Telemetry: trace $TRACE_ID posting to $TELEMETRY_HOST (background)"
  return 0
}

# ── Read diff from stdin ───────────────────────────────────────────────────

# Cap by characters — a single minified/lock file line can be 100K+.
# ~32K chars ≈ ~8K tokens, well inside Gemma 4's context while keeping
# cost/latency low.
MAX_DIFF_CHARS=32000

RAW_DIFF="$(cat)"

if [[ -z "$RAW_DIFF" ]]; then
  echo "ERROR: No diff provided on stdin." >&2
  exit 1
fi

DIFF_BYTE_COUNT=${#RAW_DIFF}
if [[ "$DIFF_BYTE_COUNT" -gt "$MAX_DIFF_CHARS" ]]; then
  DIFF_CONTENT="${RAW_DIFF:0:$MAX_DIFF_CHARS}"
  TRUNCATED_NOTE="(diff truncated from ${DIFF_BYTE_COUNT} to ${MAX_DIFF_CHARS} chars)"
else
  DIFF_CONTENT="$RAW_DIFF"
  TRUNCATED_NOTE=""
fi

# ── Build prompt ───────────────────────────────────────────────────────────

BODY_INSTRUCTION=""
if [[ "$INCLUDE_BODY" == true ]]; then
  BODY_INSTRUCTION="Include a commit body after the subject line (separated by a blank line). The body should explain WHY this change was made, not WHAT changed. Wrap at 72 characters."
else
  BODY_INSTRUCTION="Output ONLY the subject line. No body."
fi

CONTEXT_SECTION=""
if [[ -n "$EXTRA_CONTEXT" ]]; then
  CONTEXT_SECTION="
Additional context from the developer:
$EXTRA_CONTEXT"
fi

ORIGINAL_MSG_SECTION=""
if [[ -n "$ORIGINAL_MSG" ]]; then
  ORIGINAL_MSG_SECTION="
Original commit message:
$ORIGINAL_MSG"
fi

PROMPT="$(cat <<PROMPT
You are a commit message generator. Given a git diff, produce a conventional commit message.

## Format

<type>(<scope>): <subject>

[optional body]

## Types

| Type     | When to use                              |
|----------|------------------------------------------|
| feat     | New feature                              |
| fix      | Bug fix                                  |
| docs     | Documentation only                       |
| style    | Code style (formatting, semicolons, etc.)|
| refactor | Code change that neither fixes nor adds  |
| test     | Adding or updating tests                 |
| chore    | Build, tooling, dependencies             |
| perf     | Performance improvement                  |
| ci       | CI configuration changes                 |
| build    | Build system or dependencies             |
| revert   | Reverting a previous commit              |

## Rules

- Subject: imperative mood ("add" not "added"), lowercase start, no period, max 72 chars
- Scope: optional, lowercase, the package or area most affected (e.g., app, core, dive, scripts)
- Breaking changes: add ! after type/scope, e.g. feat(auth)!: change API
- ${BODY_INSTRUCTION}
- Preserve any "Co-Authored-By" or "Signed-off-by" trailers from the original
- Do NOT add trailers that were not in the original
- Output ONLY the commit message — no markdown fences, no explanation, no quotes
- If multiple types apply, choose the primary one. Prefer feat/fix over chore/refactor when both fit.

## Examples

fix(auth): resolve login timeout issue
feat(api): add user profile endpoint
refactor(grid): extract cell renderer into separate module
chore(deps): upgrade vitest to v3.1

## Input
${ORIGINAL_MSG_SECTION}

Diff: ${TRUNCATED_NOTE}
$DIFF_CONTENT
${CONTEXT_SECTION}
PROMPT
)"

# ── Generate message ───────────────────────────────────────────────────────

log "Generating commit message (cerebras, model: $MODEL)..."

GEN_START="$(iso_now)"
GENERATED_MSG="$(call_api "$PROMPT")" || {
  echo "ERROR: Failed to generate a message." >&2
  exit 1
}
GENERATED_MSG="$(strip_fences "$GENERATED_MSG")"
record_generation "generate" "$PROMPT" "$GENERATED_MSG" "$GEN_START" "$(iso_now)"

# Retry loop: if non-conventional, feed it back with a correction prompt
ATTEMPT=0
while ! is_conventional "$GENERATED_MSG"; do
  ATTEMPT=$((ATTEMPT + 1))
  DIAGNOSIS="$(diagnose_conventional_failure "$GENERATED_MSG")"

  if [[ $ATTEMPT -gt $MAX_RETRIES ]]; then
    log "WARNING: Not conventional after $MAX_RETRIES retries ($DIAGNOSIS)"
    # Output what we have anyway — caller can decide what to do
    break
  fi

  log "Retry $ATTEMPT/$MAX_RETRIES — $DIAGNOSIS"

  CORRECTION="Your previous output was NOT a valid conventional commit message.
Problem: $DIAGNOSIS
Your output was:
$GENERATED_MSG

Fix it. Output ONLY the corrected conventional commit message.
The first line MUST match: type(scope): subject
Valid types: feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert
No markdown fences, no explanation — just the commit message."

  GEN_START="$(iso_now)"
  GENERATED_MSG="$(call_api "$CORRECTION")" || {
    echo "ERROR: Retry $ATTEMPT failed." >&2
    break
  }
  GENERATED_MSG="$(strip_fences "$GENERATED_MSG")"
  record_generation "correction-$ATTEMPT" "$CORRECTION" "$GENERATED_MSG" "$GEN_START" "$(iso_now)"
done

send_telemetry || true

# Output the message
echo "$GENERATED_MSG"
