#!/usr/bin/env zsh
#
# Reap stale entries from $TMPDIR.
#
# The shell sets TMPDIR=~/.tmp (zsh/env.d/05_tmp_dir.zsh) so that temp paths
# are stable across login sessions and, on Linux, do not land on a tmpfs and
# eat RAM. The cost of moving off the OS-provided temp dir is that nothing
# reaps it any more: macOS sweeps /var/folders/... and systemd-tmpfiles sweeps
# /tmp, but ~/.tmp just grows. On neptune that reached 11 GB of abandoned
# ruby-build scratch dirs (ruby-build only cleans up after a *successful*
# build, so every failure leaks ~700 MB) and filled the disk.
#
# This is the missing reaper. It mirrors tmpwatch/systemd-tmpfiles semantics:
# delete top-level entries whose mtime is older than N days. Depth 1 only, so
# an entry is judged as a unit and we never half-gut a directory a tool is
# still using.
#
# NOTE ON --path: a `TMPDIR=/somewhere prune-tmpdir` env prefix does NOT work.
# This is a zsh script, so it sources ~/.zshenv, which sources
# zsh/env.d/05_tmp_dir.zsh, which re-exports TMPDIR=~/.tmp and clobbers
# whatever the caller passed. Use --path to aim it somewhere else; that is
# also the only safe way to exercise it in tests.
#
# Usage: prune-tmpdir [-n|--dry-run] [-d|--days N] [-p|--path DIR]
#        TMPDIR_PRUNE_DAYS=14 prune-tmpdir

emulate -L zsh
setopt no_unset pipe_fail

dry_run=0
days=${TMPDIR_PRUNE_DAYS:-7}
explicit_path=
# zsh's `<->` "any number" glob pattern has no bash spelling; an ERE in a
# variable is the one form `=~` accepts in both bash 3.2 and zsh (bash 3.2
# treats a quoted regex as a literal string).
_num_re='^[0-9]+$'

# Hand-rolled parser: BSD getopt has no long-option support (see CLAUDE.md).
while (( $# )); do
    case $1 in
        -n|--dry-run) dry_run=1 ;;
        -d|--days)
            shift
            (( $# )) || { printf '%s\n' "prune-tmpdir: --days needs a value" >&2; exit 2; }
            days=$1
            ;;
        -p|--path)
            shift
            (( $# )) || { printf '%s\n' "prune-tmpdir: --path needs a value" >&2; exit 2; }
            explicit_path=$1
            ;;
        -h|--help)
            printf '%s\n' "usage: prune-tmpdir [-n|--dry-run] [-d|--days N] [-p|--path DIR]"
            exit 0
            ;;
        *) printf '%s\n' "prune-tmpdir: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

if [[ ! $days =~ $_num_re ]]; then
    printf '%s\n' "prune-tmpdir: --days must be a non-negative integer, got: $days" >&2
    exit 2
fi

target=${explicit_path:-${TMPDIR:-}}
[[ $target == / ]] || target=${target%/}

if [[ -z $target || ! -d $target ]]; then
    printf '%s\n' "prune-tmpdir: ${target:-TMPDIR} is unset or not a directory, nothing to do"
    exit 0
fi

# Guard against reaping a shared or structural directory. This script deletes
# recursively, so a target of "/" or "$HOME" would be catastrophic; /tmp and
# /var/tmp are shared between users and already OS-reaped.
case $target in
    (/|/tmp|/var/tmp|${HOME%/})
        printf '%s\n' "prune-tmpdir: refusing to prune shared/structural dir: $target" >&2
        exit 1
        ;;
esac

# -print0 + NUL-delimited read so entries containing spaces or newlines
# survive intact. `read -r -d ''` is the rare NUL-delimiter spelling both
# zsh and bash agree on; it replaces zsh's ${(0)} flag split.
# BSD find (macOS) and GNU find both support -mindepth/-maxdepth/-print0.
stale=()
while IFS= read -r -d '' _entry; do
    stale+=("$_entry")
done < <(find "$target" -mindepth 1 -maxdepth 1 -mtime +$days -print0 2>/dev/null)

if (( ${#stale[@]} == 0 )); then
    printf '%s\n' "prune-tmpdir: $target has no entries older than ${days}d"
    exit 0
fi

# du -sk over just the doomed entries: cheap, and makes the log useful.
freed_kb=
freed_kb=$(du -sck "${stale[@]}" 2>/dev/null | tail -1 | awk '{print $1}') || freed_kb=0
[[ $freed_kb =~ $_num_re ]] || freed_kb=0

noun=
if (( ${#stale[@]} == 1 )); then noun=entry; else noun=entries; fi

if (( dry_run )); then
    e=
    for e in "${stale[@]}"; do
        printf '%s\n' "  [dry-run] would remove $e"
    done
    printf 'prune-tmpdir: [dry-run] would remove %d %s older than %dd (%d MB) from %s\n' \
        "${#stale[@]}" "$noun" "$days" "$(( freed_kb / 1024 ))" "$target"
    exit 0
fi

rm -rf -- "${stale[@]}"

printf 'prune-tmpdir: removed %d %s older than %dd (%d MB) from %s\n' \
    "${#stale[@]}" "$noun" "$days" "$(( freed_kb / 1024 ))" "$target"
