#!/bin/sh

# Run deploy only for git pull initiated merges. Plain `git merge` and checkout
# conflict-resolution operations should not trigger a full dotfiles deploy.
case "${GIT_REFLOG_ACTION:-}" in
    pull|pull\ *) ;;
    *)
        reflog_action="$(git reflog -1 --pretty=%gs 2>/dev/null || :)"
        case "$reflog_action" in
            pull|pull\ *|pull:*) ;;
            *) exit 0 ;;
        esac
        ;;
esac

# Opt-out for users mid-debugging; set DOTFILES_SKIP_POSTMERGE=1 to skip.
if [ "${DOTFILES_SKIP_POSTMERGE:-0}" = 1 ]; then
    printf '%s\n' "post-merge: DOTFILES_SKIP_POSTMERGE=1, skipping deploy." >&2
    exit 0
fi

# Hand-rolled symlink walk (the repo's canonical pattern, see
# scripts/generate-commit-msg) — zsh's ${0:A:h:h} has no POSIX spelling. The
# hook reaches this file through the .git/hooks/post-merge symlink.
_self=$0
while [ -L "$_self" ]; do
    _self_dir=$(cd -P -- "$(dirname -- "$_self")" && pwd)
    _self=$(readlink "$_self")
    case $_self in
        /*) ;;
        *) _self=$_self_dir/$_self ;;
    esac
done
SCRIPT_DIR=$(cd -P -- "$(dirname -- "$_self")" && pwd)
repo_root=$(cd -P -- "$SCRIPT_DIR/.." && pwd)

# Pick a driver: prefer the zsh one (regression baseline), fall back to the
# bash twin, and fail LOUD when neither can run (docs/bash-compatibility.md
# §D — the old "skipping" + exit 0 made `git pull` look green while the box
# drifted forever). A syntax-broken preferred driver falls through to the
# twin instead of silently skipping; only an unusable pair aborts.
driver= runner=
if command -v zsh >/dev/null 2>&1 && zsh -n "$repo_root/deploy.zsh" 2>/dev/null; then
    runner=zsh
    driver=$repo_root/deploy.zsh
elif command -v bash >/dev/null 2>&1 && bash -n "$repo_root/deploy.bash" 2>/dev/null; then
    runner=bash
    driver=$repo_root/deploy.bash
else
    printf '%s\n' "post-merge: no runnable deploy driver in $repo_root (need zsh + deploy.zsh or bash + deploy.bash)" >&2
    exit 1
fi

# Run with a wall-clock cap so a hung deploy can't hang every `git pull`.
# `timeout` is GNU coreutils (Linux stock, macOS via brew). Fall back to direct
# exec if the binary is missing.
#
# Do NOT forward "$@": git invokes post-merge with a single squash-flag arg (0
# or 1) that the drivers' fail-closed parser would reject as "unknown argument".
if command -v timeout >/dev/null 2>&1; then
    exec timeout 300 "$runner" "$driver"
else
    exec "$runner" "$driver"
fi
