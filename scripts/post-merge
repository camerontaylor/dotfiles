#!/bin/sh
# TRANSITIONAL — delete once every host has deployed past the commit that
# retired the post-merge auto-deploy (check: no host still has
# .git/hooks/post-merge -> ../../scripts/post-merge in ~/.local/dotfiles).
#
# Deploy no longer rides on `git pull`; the scheduled scripts/pull-and-deploy
# job runs it explicitly. But a host still on the OLD pull-dotfiles unit only
# runs `git pull`, so the pull that lands this change must deploy one last
# time: that deploy rewrites the unit to call pull-and-deploy (99_periodic)
# and removes this hook from .git/hooks (60_git_hooks). Without this shim the
# old hook symlink would dangle, the pull would deploy nothing, and the host
# would pull forever without deploying. No deploy fragment installs it now.

# Only for pull-initiated merges, as before.
case "${GIT_REFLOG_ACTION:-}" in
    pull|pull\ *) ;;
    *)
        reflog_action="$(git reflog -1 --pretty=%gs 2>/dev/null || :)"
        case "$reflog_action" in
            pull|pull\ *|pull:*) ;;
            *) exit 0 ;;
        esac
        ;;
esac

_self=$0
while [ -L "$_self" ]; do
    _self_dir=$(cd -P -- "$(dirname -- "$_self")" && pwd)
    _self=$(readlink "$_self")
    case $_self in
        /*) ;;
        *) _self=$_self_dir/$_self ;;
    esac
done
repo_root=$(cd -P -- "$(dirname -- "$_self")/.." && pwd)

if command -v zsh >/dev/null 2>&1 && zsh -n "$repo_root/deploy.zsh" 2>/dev/null; then
    set -- zsh "$repo_root/deploy.zsh"
elif command -v bash >/dev/null 2>&1 && bash -n "$repo_root/deploy.bash" 2>/dev/null; then
    set -- bash "$repo_root/deploy.bash"
else
    printf '%s\n' "post-merge: no runnable deploy driver in $repo_root" >&2
    exit 1
fi
# Same generous backstop as pull-and-deploy (the old 300s cap killed npm
# reifies mid-flight).
if command -v timeout >/dev/null 2>&1; then
    exec timeout --kill-after=60 3600 "$@"
fi
exec "$@"
